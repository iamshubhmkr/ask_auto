# Copy to .env and fill in. .env is gitignored.

# Groq (session 4). Model defaults to openai/gpt-oss-20b (see docs/PROGRESS.md
# for the comparison); set GROQ_MODEL to override.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
LLM_TIMEOUT_S=30
LLM_MAX_RETRIES=3

# Database built by scripts/build_database.py and scripts/build_metadata.py
DATABASE_PATH=data/askauto.db

# Schema retrieval mode for get_schema_context: full (stage 1) | vector (stage 2)
SCHEMA_MODE=full
