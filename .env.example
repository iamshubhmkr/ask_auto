# Copy to .env and fill in. .env is gitignored.

# Groq (session 4)
GROQ_API_KEY=
GROQ_MODEL=

# Database built by scripts/build_database.py and scripts/build_metadata.py
DATABASE_PATH=data/askauto.db

# Schema retrieval mode for get_schema_context: full (stage 1) | vector (stage 2)
SCHEMA_MODE=full
